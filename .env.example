# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=${OPENROUTER_API_KEY}
# Dev model profile is in config/models.json (DeepSeek v4.1 Flash). Set MODEL_PROFILE=bench for GPT-6 Luna.
MODEL_PROFILE=
WORKER_MODEL=
JEV_BASE_URL=https://openrouter.ai/api
# Ports (no defaults in code)
ACTORS_PORT=7100
RELAY_PORT=8787
ORCHESTRATOR_PORT=3000
DASHBOARD_PORT=5173
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100
DURABLE_ACTORS_PROJECT_ID=local
RELAY_BASE_URL=http://127.0.0.1:8787
NODE22=/opt/homebrew/opt/node@22/bin/node
# Immune memory on Supabase (optional; off when unset). Secret key = sb_secret_... (or legacy service_role JWT).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# on | write (file cases, never recall: cold benchmarks) | off
IMMUNE_MEMORY=
