{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd dashboard && npm install --no-audit --no-fund",
  "buildCommand": "cd dashboard && npm run build",
  "outputDirectory": "dashboard/dist",
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }] },
    {
      "source": "/api/events",
      "headers": [
        { "key": "Content-Type", "value": "text/event-stream; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!api/|assets/).*)", "destination": "/index.html" }]
}
